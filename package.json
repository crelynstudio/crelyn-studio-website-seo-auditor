{
  "name": "@crelynstudio/sitemercek",
  "version": "0.4.0-beta.1",
  "description": "Private desktop website health and technical SEO audits.",
  "productName": "SiteMercek",
  "author": "Crelyn Studio",
  "main": "dist/src/desktop/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/crelynstudio/crelyn-studio-website-seo-auditor.git"
  },
  "bugs": {
    "url": "https://github.com/crelynstudio/crelyn-studio-website-seo-auditor/issues"
  },
  "keywords": [
    "website-audit",
    "technical-seo",
    "seo",
    "broken-links",
    "crawler",
    "cli"
  ],
  "type": "module",
  "bin": {
    "site-audit": "dist/src/cli/index.js",
    "sitemercek": "dist/src/cli/index.js"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0"
  },
  "files": [
    "dist/src/**/*.js",
    "assets",
    "docs",
    "examples/demo-server.mjs",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.tr.md"
  ],
  "scripts": {
    "dev": "npm run build --silent && node dist/src/cli/index.js",
    "app": "npm run build --silent && electron .",
    "dist:win": "npm run build --silent && electron-builder --win nsis --x64",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests desktop",
    "test": "npm run build --silent && node --test dist/tests/unit/*.test.js dist/tests/integration/*.test.js",
    "prepack": "npm run build",
    "test:package": "npm run build --silent && node scripts/package-smoke.mjs"
  },
  "build": {
    "appId": "com.crelynstudio.sitemercek",
    "productName": "SiteMercek",
    "artifactName": "SiteMercek-${version}-win-x64-setup.${ext}",
    "directories": { "output": ".build" },
    "files": ["dist/src/**/*.js", "desktop/**", "assets/**", "docs/report.schema.json", "package.json"],
    "win": { "target": "nsis", "icon": "assets/sitemercek.ico" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true }
  },
  "license": "MIT",
  "dependencies": {
    "ajv": "8.20.0",
    "cheerio": "1.2.0",
    "fast-xml-parser": "5.11.2",
    "ipaddr.js": "2.2.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
