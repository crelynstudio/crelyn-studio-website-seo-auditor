{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SiteMercek ScanReport v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "version",
    "target",
    "startedAt",
    "finishedAt",
    "status",
    "config",
    "summary",
    "pages",
    "findings",
    "skippedChecks",
    "limitations",
    "rulesVersion",
    "scope",
    "resources"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "2"
    },
    "version": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "startedAt": {
      "type": "string"
    },
    "finishedAt": {
      "type": "string"
    },
    "status": {
      "enum": [
        "complete",
        "truncated",
        "aborted"
      ]
    },
    "config": {
      "type": "object",
      "required": [
        "url",
        "lang",
        "maxPages",
        "maxDepth",
        "concurrency",
        "timeout",
        "formats",
        "failOn",
        "allowPrivateNetwork",
        "checkResources",
        "maxResources"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string"
        },
        "lang": {
          "enum": [
            "en",
            "tr"
          ]
        },
        "maxPages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "timeout": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "terminal",
              "html",
              "json"
            ]
          }
        },
        "output": {
          "type": "string"
        },
        "failOn": {
          "enum": [
            "none",
            "error",
            "warning"
          ]
        },
        "allowPrivateNetwork": {
          "type": "boolean"
        },
        "checkResources": {
          "type": "boolean"
        },
        "maxResources": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "discovered",
        "crawled",
        "skipped",
        "errors",
        "warnings",
        "info"
      ],
      "additionalProperties": false,
      "properties": {
        "discovered": {
          "type": "integer",
          "minimum": 0
        },
        "crawled": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "info": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/page"
      },
      "maxItems": 1000
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/finding"
      },
      "maxItems": 100000
    },
    "skippedChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url",
          "reason",
          "checks"
        ],
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "maxItems": 20000
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rulesVersion": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "required": [
        "origin",
        "startUrl",
        "maxPages",
        "maxDepth",
        "checkResources",
        "maxResources",
        "allowPrivateNetwork"
      ],
      "additionalProperties": false,
      "properties": {
        "origin": {
          "type": "string"
        },
        "startUrl": {
          "type": "string"
        },
        "maxPages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "checkResources": {
          "type": "boolean"
        },
        "maxResources": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "allowPrivateNetwork": {
          "type": "boolean"
        }
      }
    },
    "resources": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string"
          },
          "finalUrl": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "error": {
            "type": "string"
          }
        }
      }
    }
  },
  "definitions": {
    "link": {
      "type": "object",
      "required": [
        "sourceUrl",
        "raw",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "sourceUrl": {
          "type": "string"
        },
        "raw": {
          "type": "string"
        },
        "targetUrl": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "internal",
            "external",
            "fragment",
            "mailto",
            "tel",
            "invalid",
            "unsupported"
          ]
        }
      }
    },
    "page": {
      "type": "object",
      "required": [
        "url",
        "finalUrl",
        "depth",
        "redirects",
        "headers",
        "html",
        "links"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string"
        },
        "finalUrl": {
          "type": "string"
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "redirects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "html": {
          "type": "boolean"
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/link"
          }
        },
        "error": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "h1": {
          "type": "integer",
          "minimum": 0
        },
        "canonicals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "noindex": {
          "type": "boolean"
        },
        "baseUrl": {
          "type": "string"
        },
        "discoveryLimited": {
          "type": "boolean"
        },
        "headings": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          }
        },
        "resources": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "required": [
              "url",
              "kind"
            ],
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "image",
                  "script",
                  "stylesheet"
                ]
              }
            }
          }
        },
        "resourceDiscoveryLimited": {
          "type": "boolean"
        }
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "ruleId",
        "severity",
        "result",
        "confidence",
        "url",
        "observed",
        "expected",
        "messageKey",
        "params",
        "message",
        "recommendation",
        "docsUrl"
      ],
      "additionalProperties": false,
      "properties": {
        "ruleId": {
          "type": "string",
          "pattern": "^[A-Z]+_[0-9]{3}$"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "result": {
          "enum": [
            "failed",
            "passed",
            "skipped"
          ]
        },
        "confidence": {
          "enum": [
            "certain",
            "heuristic"
          ]
        },
        "url": {
          "type": "string"
        },
        "sourceUrl": {
          "type": "string"
        },
        "targetUrl": {
          "type": "string"
        },
        "observed": {},
        "expected": {
          "type": "string"
        },
        "messageKey": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "message": {
          "type": "string"
        },
        "recommendation": {
          "type": "string"
        },
        "docsUrl": {
          "type": "string"
        }
      }
    }
  }
}
